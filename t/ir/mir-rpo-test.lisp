(in-package :cl-cc-mir/test)
(describe-sequential "MIR reverse post-order traversal"
  (it "returns the entry for a single-block function"
    (let* ((fn (cl-cc/mir:mir-make-function :single))
           (entry (cl-cc/mir:mirf-entry fn)))
      (expect (cl-cc/mir:mir-rpo fn) :to-equal (list entry))))
  (it "visits each reachable block once when paths share a successor"
    (let* ((fn (cl-cc/mir:mir-make-function :diamond))
           (entry (cl-cc/mir:mirf-entry fn))
           (left (cl-cc/mir:mir-new-block fn :label :left))
           (right (cl-cc/mir:mir-new-block fn :label :right))
           (merge (cl-cc/mir:mir-new-block fn :label :merge))
           (expected (list entry left right merge)))
      (cl-cc/mir:mir-add-succ entry left)
      (cl-cc/mir:mir-add-succ entry right)
      (cl-cc/mir:mir-add-succ left merge)
      (cl-cc/mir:mir-add-succ right merge)
      (let ((blocks (cl-cc/mir:mir-rpo fn)))
        (expect (length blocks) :to-equal 4)
        (expect (length (remove-duplicates blocks)) :to-equal 4)
        (expect (every (lambda (block) (member block expected)) blocks)
                :to-be-truthy))))
  (it "orders a chain from entry in reverse post-order"
    (let* ((fn (cl-cc/mir:mir-make-function :chain))
           (a (cl-cc/mir:mirf-entry fn))
           (b (cl-cc/mir:mir-new-block fn :label :b))
           (c (cl-cc/mir:mir-new-block fn :label :c)))
      (cl-cc/mir:mir-add-succ a b)
      (cl-cc/mir:mir-add-succ b c)
      (expect (cl-cc/mir:mir-rpo fn) :to-equal (list a b c)))))
